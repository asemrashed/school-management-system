{
  "name": "@apps/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "dotenv -e .env.local -e .env -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env.local -e .env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e .env.local -e .env -- tsx prisma/seed.ts",
    "prisma:studio": "dotenv -e .env.local -e .env -- prisma studio",
    "test": "vitest run",
    "prisma:seed:demo": "dotenv -e .env.local -e .env -- tsx prisma/seed-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@packages/config": "*",
    "@packages/shared-types": "*",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.0.6",
    "dompurify": "^3.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "isomorphic-dompurify": "^2.15.0",
    "jsdom": "^25.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.19.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  }
}
