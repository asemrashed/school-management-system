# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Session / cookies ---
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
COOKIE_SECURE=false

# --- Database (Neon default / VPS-local prod) ---
DATABASE_PROVIDER=neon
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Storage provider factory ---
# cloudinary | local (saves to UPLOAD_DIR and serves at /files; no cloud account needed) | s3 | r2 (not wired)
STORAGE_PROVIDER=cloudinary
# UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Messaging: SMTP (always on — the safety channel) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School <no-reply@school.test>"

# --- Messaging: SMS (env toggle — see messaging-domain.md) ---
SMS_GATEWAY=false
SMS_PROVIDER=none
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# --- Device control (Phase 4) ---
DEVICE_CONTROL_ENABLED=false

# --- Public URLs (used for payment return links and local file URLs) ---
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# --- Payment gateways ---
# PAYMENT_SANDBOX=true shows a practice checkout (bKash/Nagad/card buttons, no real money).
# NEVER enable it in production: with it on, no real gateway is contacted.
PAYMENT_SANDBOX=false
BKASH_ENABLED=false
BKASH_API_KEY=
BKASH_API_SECRET=
NAGAD_ENABLED=false
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- Seed data (optional) ---
SEED_SCHOOL_NAME="Green Valley English Medium School"
SEED_SUPER_ADMIN_EMAIL=admin@school.test
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
