# ---------- Dependencies ----------
node_modules/
**/node_modules/

# ---------- Environment files (secrets) ----------
# Ignore every .env*, but keep the *.example templates in git.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# ---------- Next.js (apps/web) ----------
apps/web/.next/
apps/web/out/
.next/
out/
next-env.d.ts

# ---------- Build output ----------
dist/
build/
coverage/
*.tsbuildinfo
.turbo/

# ---------- Local file uploads (STORAGE_PROVIDER=local) ----------
apps/api/uploads/
uploads/

# ---------- Prisma ----------
# Keep prisma/migrations in git; ignore only local/generated artifacts.
*.db
*.db-journal

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Testing / tooling caches ----------
.vitest/
.eslintcache
.cache/
playwright-report/
test-results/

# ---------- Editors / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------- Vercel / misc ----------
.vercel
*.pem

# ---------- Claude Code local settings ----------
.claude/settings.local.json
